# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Set at least one provider key. Groq is the primary provider (higher free-tier
# RPM); OpenRouter is the automatic fallback (broader model catalogue).

# Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: override the default models
# CTF_MODEL=meta-llama/llama-3.3-70b-instruct:free   # OpenRouter default
# CTF_GROQ_MODEL=llama-3.3-70b-versatile             # Groq default
